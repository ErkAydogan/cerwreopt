# Bu dosyayı .env olarak kopyalayın (cp .env.example .env) ve değerleri değiştirin.
# Gerçek .env repoya girmez (.gitignore). Canlıda bu değerler gizli bilgi kasasından gelir.
API_KEY=change-me
POSTGRES_USER=crew
POSTGRES_PASSWORD=change-me
POSTGRES_DB=crewreopt
RABBITMQ_USER=crew
RABBITMQ_PASSWORD=change-me
OPS_DATE=2026-11-23
SOLVER_TIME_LIMIT_S=10
MIN_REST=60
MAX_DUTY=780
LOG_LEVEL=INFO
# docker compose dışında (yerel) çalıştırırken:
# DATABASE_URL=postgresql+psycopg://crew:change-me@localhost:5432/crewreopt
# RABBITMQ_URL=amqp://crew:change-me@localhost:5672/%2F
# Demo dışarıya açıldıysa genel adresi; arayüz bu adresin QR kodunu gösterir (boşsa QR görünmez)
PUBLIC_URL=
