# Bu dosyayı .env olarak kopyalayın (cp .env.example .env) ve değerleri değiştirin.
# Gerçek .env repoya girmez (.gitignore). Canlıda bu değerler gizli bilgi kasasından gelir.
API_KEY=change-me
POSTGRES_USER=crew
POSTGRES_PASSWORD=change-me
POSTGRES_DB=crewreopt
RABBITMQ_USER=crew
RABBITMQ_PASSWORD=change-me
OPS_DATE=2026-11-23
# Kod varsayılanı 10 sn; fırtına senaryosu (150 görev) konteynerde ~10 sn sürdüğü için burada 30
SOLVER_TIME_LIMIT_S=30
MIN_REST=60
MAX_DUTY=780
LOG_LEVEL=INFO
# docker compose dışında (yerel) çalıştırırken:
# DATABASE_URL=postgresql+psycopg://crew:change-me@localhost:5432/crewreopt
# RABBITMQ_URL=amqp://crew:change-me@localhost:5672/%2F
# Haritada gerçek THY uçak konumları (OpenSky Network, ADS-B). 0 = kapalı. Plan verisi bundan bağımsızdır.
LIVE_TRAFFIC=1
# Kaç saniyede bir yeniden çekilsin. 900 = 15 dk: günde 96 sorgu, hesapsız kotaya (~100) sığar.
LIVE_TTL_S=900
# Demo dışarıya açıldıysa genel adresi; arayüz bu adresin QR kodunu gösterir (boşsa QR görünmez)
PUBLIC_URL=
